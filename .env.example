# ---------------------------------------------------------------------------
# Environment variables for local Docker / docker-compose use.
# This is a static site — Render itself needs NO env vars to serve it.
# These are only used for local container customization.
# ---------------------------------------------------------------------------

# Port exposed on your host machine when running via docker-compose
# (container always listens internally on 8080)
HOST_PORT=8080

# Timezone for container logs/date output
TZ=UTC

# ---------------------------------------------------------------------------
# CI/CD secret (set this in GitHub repo Settings > Secrets, NOT in this file)
# RENDER_DEPLOY_HOOK_URL=https://api.render.com/deploy/srv-xxxxxxxxxxxx?key=xxxxxxxxxxxx
# ---------------------------------------------------------------------------